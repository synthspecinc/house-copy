{
  "name": "house-copy",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Amazon SES template editor with protected content fields and revision history",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:e2e": "playwright test",
    "notices": "node scripts/notices.js",
    "check": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1161.0",
    "@aws-sdk/client-sts": "3.1161.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "handlebars": "4.7.10",
    "openid-client": "6.8.9",
    "parse5": "8.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "jose": "6.2.15",
    "undici": "7.30.1"
  }
}
